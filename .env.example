# Public URL of the deployed site. Used for canonical links, sitemap, and Open Graph.
NEXT_PUBLIC_SITE_URL=https://www.rhinowindowtint.com

# Live Google reviews (optional). Without these, the site shows the curated reviews in data/reviews.ts.
# Create a key in Google Cloud with the "Places API (New)" enabled.
GOOGLE_PLACES_API_KEY=
# Optional. If blank, the site looks the place up by name and address once a day.
GOOGLE_PLACE_ID=

# Quote form email delivery (optional). Without these, requests are accepted but not emailed.
RESEND_API_KEY=
QUOTE_TO_EMAIL=
QUOTE_FROM_EMAIL=Rhino Website <quotes@yourdomain.com>
